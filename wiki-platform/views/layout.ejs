<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Wiki Platform</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="header">
    <div class="container header-content">
      <a href="/" class="logo">Wiki Competitions</a>
      <nav class="nav">
        <% (navbarLinks || []).forEach(function(link) { %>
          <a href="<%= link.href %>"><%= link.label %></a>
        <% }); %>
        <a href="/admin/login">Вход</a>
      </nav>
    </div>
  </header>
  
  <main>
    <%- body %>
  </main>
  
  <footer class="footer">
    <div class="container">
      <p>&copy; <%= new Date().getFullYear() %> Wiki Competitions Platform</p>
    </div>
  </footer>
  
  <script src="/js/main.js"></script>
</body>
</html>
