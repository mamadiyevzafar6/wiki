<div style="display: flex; gap: 20px; margin-bottom: 30px;">
  <button type="button" class="btn btn-primary" onclick="showCreateCategory()">+ Добавить категорию</button>
</div>

<!-- Create Category Form -->
<div id="create-category-form" style="display: none; max-width: 600px; margin-bottom: 30px; padding: 20px; border: 1px solid #e0e0e0;">
  <h3 style="margin-bottom: 20px; font-size: 18px;">Новая категория</h3>
  <form method="POST" action="/admin/categories">
    <input type="hidden" name="action" value="create">
    <div class="form-group">
      <label class="form-label" for="cat_name">Название *</label>
      <input type="text" id="cat_name" name="name" class="form-input" required>
    </div>
    <div class="form-group">
      <label class="form-label" for="cat_slug">Slug</label>
      <input type="text" id="cat_slug" name="slug" class="form-input" placeholder="Оставите пустым — сгенерируется автоматически">
    </div>
    <div class="form-group">
      <label class="form-label" for="cat_description">Описание</label>
      <textarea id="cat_description" name="description" class="form-textarea" rows="3"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Создать</button>
    <button type="button" class="btn" onclick="hideCreateCategory()">Отмена</button>
  </form>
</div>

<table class="table">
  <thead>
    <tr>
      <th>Название</th>
      <th>Slug</th>
      <th>Описание</th>
      <th>Действия</th>
    </tr>
  </thead>
  <tbody>
    <% if (categories.length > 0) { %>
      <% categories.forEach(function(category) { %>
        <tr>
          <td><%= category.name %></td>
          <td><code><%= category.slug %></code></td>
          <td><%= category.description || '—' %></td>
          <td class="table-actions">
            <button type="button" class="btn btn-sm" onclick="editCategory(<%= category.id %>, '<%= category.name %>', '<%= category.slug %>', '<%= category.description || '' %>')">Ред.</button>
            <form method="POST" action="/admin/categories" style="display: inline;" onsubmit="return confirm('Удалить категорию?');">
              <input type="hidden" name="action" value="delete">
              <input type="hidden" name="id" value="<%= category.id %>">
              <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
            </form>
          </td>
        </tr>
      <% }); %>
    <% } else { %>
      <tr>
        <td colspan="4" style="text-align: center; color: #888;">Категории не добавлены</td>
      </tr>
    <% } %>
  </tbody>
</table>

<!-- Edit Category Modal (inline) -->
<div id="edit-category-form" style="display: none; max-width: 600px; margin-top: 30px; padding: 20px; border: 1px solid #e0e0e0;">
  <h3 style="margin-bottom: 20px; font-size: 18px;">Редактировать категорию</h3>
  <form method="POST" action="/admin/categories">
    <input type="hidden" name="action" value="update">
    <input type="hidden" name="id" id="edit_cat_id">
    <div class="form-group">
      <label class="form-label" for="edit_cat_name">Название *</label>
      <input type="text" id="edit_cat_name" name="name" class="form-input" required>
    </div>
    <div class="form-group">
      <label class="form-label" for="edit_cat_slug">Slug</label>
      <input type="text" id="edit_cat_slug" name="slug" class="form-input">
    </div>
    <div class="form-group">
      <label class="form-label" for="edit_cat_description">Описание</label>
      <textarea id="edit_cat_description" name="description" class="form-textarea" rows="3"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <button type="button" class="btn" onclick="document.getElementById('edit-category-form').style.display='none'">Отмена</button>
  </form>
</div>

<script>
function showCreateCategory() {
  document.getElementById('create-category-form').style.display = 'block';
}
function hideCreateCategory() {
  document.getElementById('create-category-form').style.display = 'none';
}
function editCategory(id, name, slug, description) {
  document.getElementById('edit_cat_id').value = id;
  document.getElementById('edit_cat_name').value = name;
  document.getElementById('edit_cat_slug').value = slug;
  document.getElementById('edit_cat_description').value = description;
  document.getElementById('edit-category-form').style.display = 'block';
}
</script>
