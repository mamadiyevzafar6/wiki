<div style="max-width: 500px;">
  <% if (isFirstLogin) { %>
    <div class="alert alert-error">
      <strong>Требуется смена пароля!</strong><br>
      Это ваш первый вход. Пожалуйста, смените пароль по умолчанию.
    </div>
  <% } %>
  
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  
  <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>
  
  <form method="POST" action="/admin/change-password">
    <% if (!isFirstLogin) { %>
      <div class="form-group">
        <label class="form-label" for="current_password">Текущий пароль</label>
        <input type="password" id="current_password" name="current_password" class="form-input" required>
      </div>
    <% } else { %>
      <input type="hidden" name="first" value="true">
    <% } %>
    
    <div class="form-group">
      <label class="form-label" for="new_password">Новый пароль</label>
      <input type="password" id="new_password" name="new_password" class="form-input" minlength="6" required>
      <small style="color: #888; font-size: 12px;">Минимум 6 символов</small>
    </div>
    
    <div class="form-group">
      <label class="form-label" for="confirm_password">Подтверждение пароля</label>
      <input type="password" id="confirm_password" name="confirm_password" class="form-input" minlength="6" required>
    </div>
    
    <button type="submit" class="btn btn-primary">Сменить пароль</button>
  </form>
  
  <p class="mt-20">
    <a href="/admin/dashboard">← Вернуться в панель управления</a>
  </p>
</div>
