<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-number"><%= stats.programsCount %></div>
    <div class="stat-label">Программ</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= stats.categoriesCount %></div>
    <div class="stat-label">Категорий</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= stats.countriesCount %></div>
    <div class="stat-label">Стран</div>
  </div>
</div>

<div class="grid">
  <a href="/admin/programs" class="card" style="text-align: center;">
    <h3 class="card-title" style="margin-bottom: 10px;">📄 Программы</h3>
    <p style="font-size: 14px; color: #888;">Управление программами и соревнованиями</p>
  </a>
  <a href="/admin/categories" class="card" style="text-align: center;">
    <h3 class="card-title" style="margin-bottom: 10px;">📁 Категории</h3>
    <p style="font-size: 14px; color: #888;">Типы соревнований и грантов</p>
  </a>
  <a href="/admin/countries" class="card" style="text-align: center;">
    <h3 class="card-title" style="margin-bottom: 10px;">🌍 Страны</h3>
    <p style="font-size: 14px; color: #888;">География программ</p>
  </a>
  <a href="/admin/users" class="card" style="text-align: center;">
    <h3 class="card-title" style="margin-bottom: 10px;">👥 Пользователи</h3>
    <p style="font-size: 14px; color: #888;">Управление администраторами</p>
  </a>
  <a href="/admin/settings" class="card" style="text-align: center;">
    <h3 class="card-title" style="margin-bottom: 10px;">⚙️ Настройки</h3>
    <p style="font-size: 14px; color: #888;">Настройки сайта и навигации</p>
  </a>
  <a href="/admin/change-password" class="card" style="text-align: center;">
    <h3 class="card-title" style="margin-bottom: 10px;">🔐 Безопасность</h3>
    <p style="font-size: 14px; color: #888;">Сменить пароль</p>
  </a>
</div>
