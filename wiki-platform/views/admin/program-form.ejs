<div style="max-width: 800px;">
  <h2 style="margin-bottom: 30px; font-size: 20px;"><%= isEdit ? 'Редактировать программу' : 'Новая программа' %></h2>
  
  <form method="POST" action="<%= isEdit ? '/admin/programs/' + program.id : '/admin/programs' %>">
    <div class="form-group">
      <label class="form-label" for="title">Название *</label>
      <input type="text" id="title" name="title" class="form-input" value="<%= program ? program.title : '' %>" required>
    </div>
    
    <div class="form-group">
      <label class="form-label" for="slug">Slug (URL)</label>
      <input type="text" id="slug" name="slug" class="form-input" value="<%= program ? program.slug : '' %>" placeholder="Оставите пустым — сгенерируется автоматически">
      <small style="color: #888; font-size: 12px;">Латиницей, например: hackathon-2025</small>
    </div>
    
    <div class="form-group">
      <label class="form-label" for="category_id">Категория</label>
      <select id="category_id" name="category_id" class="form-select">
        <option value="">— Не выбрано —</option>
        <% categories.forEach(function(cat) { %>
          <option value="<%= cat.id %>" <%= program && program.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
        <% }); %>
      </select>
    </div>
    
    <div class="form-group">
      <label class="form-label" for="country_id">Страна</label>
      <select id="country_id" name="country_id" class="form-select">
        <option value="">— Не выбрано —</option>
        <% countries.forEach(function(country) { %>
          <option value="<%= country.id %>" <%= program && program.country_id == country.id ? 'selected' : '' %>><%= country.flag_icon_url || '' %> <%= country.name %></option>
        <% }); %>
      </select>
    </div>
    
    <div class="form-group">
      <label class="form-label" for="deadline_date">Дедлайн</label>
      <input type="date" id="deadline_date" name="deadline_date" class="form-input" value="<%= program && program.deadline_date ? new Date(program.deadline_date).toISOString().split('T')[0] : '' %>">
    </div>
    
    <div class="form-group">
      <label class="form-label" for="content">Описание (Markdown)</label>
      <textarea id="content" name="content" class="form-textarea" rows="15"><%= program ? program.content : '' %></textarea>
      <small style="color: #888; font-size: 12px;">Поддерживается Markdown разметка</small>
    </div>
    
    <div class="form-group">
      <label class="form-checkbox">
        <input type="checkbox" name="is_published" <%= !program || program.is_published ? 'checked' : '' %>>
        Опубликовано
      </label>
    </div>
    
    <div style="display: flex; gap: 10px;">
      <button type="submit" class="btn btn-primary"><%= isEdit ? 'Сохранить' : 'Создать' %></button>
      <a href="/admin/programs" class="btn">Отмена</a>
    </div>
  </form>
</div>
